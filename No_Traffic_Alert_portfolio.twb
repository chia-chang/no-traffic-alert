      <aliases enabled='yes' />
      <column caption='less than threshold filter' datatype='boolean' name='[Calculation_1260163516106428416]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Calculation_911000000000000001] &lt; [Parameters].[Parameter 1]' />
      </column>
      <column caption='50 days filter' datatype='boolean' name='[Calculation_1486399001697423366]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[DateOnly] &gt; DATEADD(&apos;day&apos;,-50,[Calculation_1486399003099103274])' />
      </column>
      <column caption='Is Live?' datatype='string' name='[Calculation_1486399003040694304]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([Go Live Date]) = TRUE then &apos;Not Live&apos; else &apos;Live&apos; end' />
      </column>
      <column caption='Date _ Have Traffic' datatype='date' name='[Calculation_1486399003093205027]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='if [Traffic Flag] = &apos;Have Traffic&apos; then [DateOnly] else NULL end' />
      </column>
      <column caption='Casino Last Traffic Day' datatype='date' name='[Calculation_1486399003093372965]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{FIXED [Environment code],[Casino ID]:MAX([Calculation_1486399003093205027])}' />
      </column>
      <column caption='Report Day' datatype='date' name='[Calculation_1486399003099103274]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{max([DateOnly])}' />
      </column>
      <column caption='Days since last traffic' datatype='integer' name='[Calculation_1486399003099144235]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;,[Calculation_1486399003093372965],[Calculation_1486399003099103274])' />
      </column>
      <column caption='Zero Traffic Days' datatype='integer' name='[Calculation_1486399003099553836]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='7 - &#10;{FIXED [Environment code],[Casino ID]:&#10;countd(if [DateOnly] &gt;= [Calculation_1486399003100078125] then [Calculation_1486399003093205027] else null end)}' />
      </column>
      <column caption='Date Start _ 7' datatype='date' name='[Calculation_1486399003100078125]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(DATEADD(&apos;day&apos;,-6,[Calculation_1486399003099103274]))' />
      </column>
      <column caption='Date Start _ 50' datatype='date' name='[Calculation_1486399003103174702]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(DATEADD(&apos;day&apos;,-49,[Calculation_1486399003099103274]))' />
      </column>
      <column caption='Assigned to KAM (demo: all)' datatype='boolean' name='[Calculation_402438912658776081]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='TRUE' />
      </column>
      <column caption='Date Filter _ 7 days' datatype='boolean' name='[Calculation_4064428315080609798]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[DateOnly] &gt;= [Calculation_1486399003100078125]' />
      </column>
      <column caption='Team scope (demo: all)' datatype='boolean' name='[Calculation_547116999441444865]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='TRUE' />
      </column>
      <column caption='Total wager (50d)' datatype='real' name='[Calculation_911000000000000001]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [Environment code],[Casino ID] : SUM(IF [DateOnly] &gt;= [Calculation_1486399003103174702] THEN [Wager Eur] END)}' />
      </column>
      <column caption='Provider last traffic day' datatype='date' name='[Calculation_911000000000000003]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{FIXED [Environment code],[Casino ID],[Game Provider] : MAX([Calculation_1486399003093205027])}' />
      </column>
      <column caption='Provider have-traffic days' datatype='integer' name='[Calculation_911000000000000004]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [Environment code],[Casino ID],[Game Provider] : COUNTD(IF [DateOnly] &gt;= [Calculation_1486399003103174702] THEN [Calculation_1486399003093205027] END)}' />
      </column>
      <column caption='Potential Wager' datatype='real' name='[Calculation_911000000000000006]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [Environment code],[Casino ID] : SUM(IF [Calculation_911000000000000004] &gt; 0 AND [DateOnly] &gt;= [Calculation_1486399003103174702] THEN [Wager Eur] / [Calculation_911000000000000004] * [Casino&apos;s Zero Traffic Days in past 7 days (copy)_1486399003116851248] END)}' />
      </column>
      <column caption='Provider days dark' datatype='integer' name='[Calculation_911000000000000007]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;,[Calculation_911000000000000003],[Calculation_1486399003099103274])' />
      </column>
      <column caption='Casino €/day when running' datatype='real' name='[Calculation_911000000000000008]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [Environment code],[Casino ID] : SUM(IF NOT ISNULL([Calculation_911000000000000003]) AND [DateOnly] &gt;= [Calculation_1486399003103174702] THEN [Wager Eur] / [Calculation_911000000000000004] END)}' />
      </column>
      <column caption='Days with traffic (50d)' datatype='integer' name='[Calculation_911000000000000031]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [Environment code],[Casino ID] : COUNTD(IF [DateOnly] &gt;= [Calculation_1486399003103174702] THEN [Calculation_1486399003093205027] END)}' />
      </column>
      <column caption='Casino has stopped provider' datatype='boolean' name='[Calculation_911000000000000033]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='{FIXED [Environment code],[Casino ID] : MAX(IF [Calculation_911000000000000004] &gt; 0 AND [Casino&apos;s Zero Traffic Days in past 7 days (copy)_1486399003116851248] &gt;= 1 THEN 1 ELSE 0 END)} = 1' />
      </column>
      <column caption='Never-used providers' datatype='integer' name='[Calculation_911000000000000034]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [Environment code],[Casino ID] : COUNTD(IF [Calculation_911000000000000004] = 0 THEN [Game Provider] END)}' />
      </column>
      <column caption='Cell label' datatype='string' name='[Calculation_911000000000000035]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_911000000000000004] = 0 &#10;THEN &apos;–&apos; &#10;ELSEIF [Casino&apos;s Zero Traffic Days in past 7 days (copy)_1486399003116851248] = 0 THEN &apos;&apos; &#10;ELSE STR([Casino&apos;s Zero Traffic Days in past 7 days (copy)_1486399003116851248]) END' />
      </column>
      <column caption='Cell status' datatype='string' name='[Calculation_911000000000000036]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_911000000000000004] = 0 THEN &apos;Never used (50d)&apos; ELSE STR([Casino&apos;s Zero Traffic Days in past 7 days (copy)_1486399003116851248]) END' />
      </column>
      <column caption='Day status' datatype='string' name='[Calculation_911000000000000037]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_911000000000000004] = 0 THEN &apos;Never used (50d)&apos; ELSE [Traffic Flag] END' />
      </column>
      <column caption='Date Start _ 28' datatype='date' name='[Calculation_928000000000000000]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(DATEADD(&apos;day&apos;, -28, [Calculation_1486399003100078125]))' />
      </column>
      <column caption='Normal Week Wager' datatype='real' name='[Calculation_928000000000000001]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Environment code],[Casino ID] : SUM( IF [Grouping Set Level] = &quot;casino-provider&quot; AND [DateOnly] &gt;= [Calculation_928000000000000000] AND [DateOnly] &lt; [Calculation_1486399003100078125] THEN [Wager Eur] END ) } / 4' />
      </column>
      <column caption='This Week Wager' datatype='real' name='[Calculation_928000000000000002]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Environment code],[Casino ID] : SUM( IF [Grouping Set Level] = &quot;casino-provider&quot; AND [DateOnly] &gt;= [Calculation_1486399003100078125] THEN [Wager Eur] END ) }' />
      </column>
      <column caption='Wager Change %' datatype='real' name='[Calculation_928000000000000003]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_928000000000000001] &gt; 0 THEN IFNULL([Calculation_928000000000000002],0) / [Calculation_928000000000000001] - 1 END' />
      </column>
      <column caption='Potential Wager' datatype='real' name='[Calculation_928000000000000004]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Environment code],[Casino ID] : &#10;SUM( { FIXED [Environment code],[Casino ID],[Game Provider] : &#10;        MAX( IF [Grouping Set Level] = &quot;casino-provider&quot; &#10;                AND IFNULL([Calculation_928000000000000007],0) &gt;= [Parameters].[Parameter 4] &#10;                AND [Casino&apos;s Zero Traffic Days in past 7 days (copy)_1486399003116851248] &gt;= 1 &#10;                AND [Calculation_928000000000000009] &gt;= [Parameters].[Parameter 4]&#10;            THEN [Calculation_928000000000000009] END ) } ) }' />
      </column>
      <column caption='Normal Week Traffic Days' datatype='integer' name='[Calculation_928000000000000005]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Environment code],[Casino ID] : COUNTD( IF [DateOnly] &gt;= [Calculation_928000000000000000] AND [DateOnly] &lt; [Calculation_1486399003100078125] THEN [Calculation_1486399003093205027] END ) }' />
      </column>
      <column caption='Has no-traffic provider this week' datatype='boolean' name='[Calculation_928000000000000006]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='{ FIXED [Environment code],[Casino ID] : &#10;    MAX( IF [Grouping Set Level] = &quot;casino-provider&quot; &#10;        AND IFNULL([Calculation_928000000000000007],0) &gt;= [Parameters].[Parameter 4] &#10;        AND [Casino&apos;s Zero Traffic Days in past 7 days (copy)_1486399003116851248] &gt;= 1 &#10;        AND [Calculation_928000000000000009] &gt;= [Parameters].[Parameter 4]&#10;        THEN 1 ELSE 0 END ) } = 1' />
      </column>
      <column caption='Provider Normal Week' datatype='real' name='[Calculation_928000000000000007]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Environment code],[Casino ID],[Game Provider] : SUM( IF [DateOnly] &gt;= [Calculation_928000000000000000] AND [DateOnly] &lt; [Calculation_1486399003100078125] THEN [Wager Eur] END ) } / 4' />
      </column>
      <column caption='Provider This Week' datatype='real' name='[Calculation_928000000000000008]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Environment code],[Casino ID],[Game Provider] : SUM( IF [DateOnly] &gt;= [Calculation_1486399003100078125] THEN [Wager Eur] END ) }' />
      </column>
      <column caption='Provider Gap' datatype='real' name='[Calculation_928000000000000009]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL([Calculation_928000000000000007],0) - IFNULL([Calculation_928000000000000008],0)' />
      </column>
      <column caption='Casino Max Provider Gap' datatype='real' name='[Calculation_928000000000000010]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Environment code],[Casino ID] : MAX( IF [Grouping Set Level] = &quot;casino-provider&quot; THEN [Calculation_928000000000000009] END ) }' />
      </column>
      <column caption='Casino Positive Gap' datatype='real' name='[Calculation_928000000000000011]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Environment code],[Casino ID] : SUM( { FIXED [Environment code],[Casino ID],[Game Provider] : MAX( IF [Grouping Set Level] = &quot;casino-provider&quot; AND [Calculation_928000000000000009] &gt; 0 THEN [Calculation_928000000000000009] END ) } ) }' />
      </column>
      <column caption='Biggest Drop Provider' datatype='string' name='[Calculation_928000000000000012]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='{ FIXED [Environment code],[Casino ID] : MIN( IF [Grouping Set Level] = &quot;casino-provider&quot; AND [Calculation_928000000000000009] = [Calculation_928000000000000010] AND [Calculation_928000000000000009] &gt; 0 THEN [Game Provider] END ) }' />
      </column>
      <column caption='Biggest Provider Normal Week' datatype='real' name='[Calculation_928000000000000013]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Environment code],[Casino ID] : MAX( IF [Game Provider] = [Calculation_928000000000000012] THEN [Calculation_928000000000000007] END ) }' />
      </column>
      <column caption='Biggest Provider This Week' datatype='real' name='[Calculation_928000000000000014]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Environment code],[Casino ID] : MAX( IF [Game Provider] = [Calculation_928000000000000012] THEN IFNULL([Calculation_928000000000000008],0) END ) }' />
      </column>
      <column caption='Provider Stopped Casinos' datatype='integer' name='[Calculation_928000000000000015]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Game Provider] : COUNTD( IF [Calculation_928000000000000007] &gt;= [Parameters].[Parameter 4] AND IFNULL([Calculation_928000000000000008],0) = 0 THEN [Casino ID] END ) }' />
      </column>
      <column caption='Biggest Provider Stopped Casinos' datatype='integer' name='[Calculation_928000000000000016]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Environment code],[Casino ID] : MAX( IF [Game Provider] = [Calculation_928000000000000012] THEN [Calculation_928000000000000015] END ) }' />
      </column>
      <column caption='Group Abnormal Casinos' datatype='integer' name='[Calculation_928000000000000017]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Casino group] : COUNTD( IF [Calculation_928000000000000006] THEN [Casino ID] END ) }' />
      </column>
      <column caption='Group Size' datatype='integer' name='[Calculation_928000000000000018]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Casino group] : COUNTD([Casino ID]) }' />
      </column>
      <column caption='What Dropped' datatype='string' name='[Calculation_928000000000000019]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_928000000000000026] = 0 THEN &apos;Spread across lines — none down &apos; + STR([Parameters].[Parameter 2]) + &apos;% alone&apos; ELSEIF [Calculation_928000000000000026] = 1 THEN [Calculation_928000000000000028] + &apos; only — &apos; + IIF([Calculation_928000000000000029] &lt;= -1, &apos;stopped&apos;, &apos;down &apos; + STR(INT(ROUND(-[Calculation_928000000000000029] * 100, 0))) + &apos;%&apos;) + IIF([Calculation_928000000000000025] &gt; 1, &apos;, other &apos; + STR([Calculation_928000000000000025] - 1) + &apos; lines normal&apos;, &apos;&apos;) + IIF([Calculation_928000000000000029] &lt;= -1 AND [Calculation_928000000000000030] &gt;= 3, &apos; · also stopped at &apos; + STR([Calculation_928000000000000030] - 1) + &apos; other casinos this week&apos;, &apos;&apos;) ELSEIF [Calculation_928000000000000026] &gt;= [Calculation_928000000000000025] THEN &apos;Whole casino — all &apos; + STR([Calculation_928000000000000025]) + &apos; lines down&apos; + IIF([Calculation_928000000000000027] &gt; 0, &apos; (&apos; + STR([Calculation_928000000000000027]) + &apos; stopped)&apos;, &apos;&apos;) ELSE STR([Calculation_928000000000000026]) + &apos; of &apos; + STR([Calculation_928000000000000025]) + &apos; lines down&apos; + IIF([Calculation_928000000000000027] &gt; 0, &apos; (&apos; + STR([Calculation_928000000000000027]) + &apos; stopped)&apos;, &apos;&apos;) END + IIF([Calculation_928000000000000017] &gt;= 3, &apos; (&apos; + STR([Calculation_928000000000000017]) + &apos; of &apos; + STR([Calculation_928000000000000018]) + &apos; in group)&apos;, &apos;&apos;)' />
      </column>
      <column caption='Provider Outage' datatype='boolean' name='[Calculation_928000000000000020]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Calculation_928000000000000015] &gt;= 3' />
      </column>
      <column caption='Same Day Enabled Count' datatype='integer' name='[Calculation_928000000000000021]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Casino Provider Go Live Date (copy)_1486399003113521199] : COUNTD( IF [Cleanup (copy)_1260163516106547201] THEN [Casino ID] END ) }' />
      </column>
      <column caption='Silence Status' datatype='string' name='[Calculation_928000000000000022]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Casino Provider Go Live Date (copy)_1486399003113521199] &gt;= [Calculation_1486399003103174702] THEN STR(DATEDIFF(&apos;day&apos;, [Casino Provider Go Live Date (copy)_1486399003113521199], [Calculation_1486399003099103274])) + &apos; days — never live&apos; + IIF([Calculation_928000000000000021] &gt;= 3, &apos; (enabled the same day as &apos; + STR([Calculation_928000000000000021] - 1) + &apos; other casinos)&apos;, &apos;&apos;) ELSE &apos;50+ days&apos; END' />
      </column>
      <column caption='Provider Change %' datatype='real' name='[Calculation_928000000000000023]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_928000000000000007] &gt; 0 THEN IFNULL([Calculation_928000000000000008],0) / [Calculation_928000000000000007] - 1 END' />
      </column>
      <column caption='Provider Dropped.' datatype='boolean' name='[Calculation_928000000000000024]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Calculation_928000000000000007] &gt;= [Parameters].[Parameter 4] AND [Calculation_928000000000000023] &lt;= -[Parameters].[Parameter 2] / 100' />
      </column>
      <column caption='Provider Active' datatype='integer' name='[Calculation_928000000000000025]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Environment code],[Casino ID] : COUNTD( IF [Grouping Set Level] = &quot;casino-provider&quot; AND [Calculation_928000000000000007] &gt;= [Parameters].[Parameter 4] THEN [Game Provider] END ) }' />
      </column>
      <column caption='Provider Dropped' datatype='integer' name='[Calculation_928000000000000026]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Environment code],[Casino ID] : COUNTD( IF [Grouping Set Level] = &quot;casino-provider&quot; AND [Calculation_928000000000000024] THEN [Game Provider] END ) }' />
      </column>
      <column caption='Provider Stopped' datatype='integer' name='[Calculation_928000000000000027]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Environment code],[Casino ID] : COUNTD( IF [Grouping Set Level] = &quot;casino-provider&quot; AND [Calculation_928000000000000007] &gt;= [Parameters].[Parameter 4] AND IFNULL([Calculation_928000000000000008],0) = 0 THEN [Game Provider] END ) }' />
      </column>
      <column caption='Dropped Provider Name' datatype='string' name='[Calculation_928000000000000028]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='{ FIXED [Environment code],[Casino ID] : MIN( IF [Grouping Set Level] = &quot;casino-provider&quot; AND [Calculation_928000000000000024] THEN [Game Provider] END ) }' />
      </column>
      <column caption='Dropped Provider Change %' datatype='real' name='[Calculation_928000000000000029]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Environment code],[Casino ID] : MIN( IF [Game Provider] = [Calculation_928000000000000028] THEN [Calculation_928000000000000023] END ) }' />
      </column>
      <column caption='Dropped Provider Stopped Casinos' datatype='integer' name='[Calculation_928000000000000030]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Environment code],[Casino ID] : MAX( IF [Game Provider] = [Calculation_928000000000000028] THEN [Calculation_928000000000000015] END ) }' />
      </column>
      <column caption='Provider Status' datatype='string' name='[Calculation_928000000000000031]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF IFNULL([Calculation_928000000000000007],0) &lt; [Parameters].[Parameter 4] THEN &apos;Negligible in normal weeks&apos; ELSEIF IFNULL([Calculation_928000000000000008],0) = 0 THEN &apos;Stopped&apos; ELSEIF [Calculation_928000000000000024] THEN &apos;Down&apos; ELSE &apos;Normal&apos; END' />
      </column>
      <column caption='Missing this week' datatype='real' name='[Calculation_928000000000000032]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF IFNULL([Calculation_928000000000000007],0) &gt;= [Parameters].[Parameter 4] &#10;    AND [Casino&apos;s Zero Traffic Days in past 7 days (copy)_1486399003116851248] &gt;= 1 &#10;    AND [Calculation_928000000000000009] &gt;= [Parameters].[Parameter 4] &#10;THEN [Calculation_928000000000000009] END' />
      </column>
      <column caption='Section' datatype='string' name='[Calculation_928000000000000033]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1486399003099553836] &gt;= 1 THEN &apos;1 · Whole casino had no traffic for at least one full day this week&apos; ELSE &apos;2 · Casino ran every day, but some of its lines did not&apos; END' />
      </column>
      <column caption='Whole casino dark' datatype='string' name='[Calculation_928000000000000034]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IIF([Calculation_1486399003099553836] &gt;= 1, STR([Calculation_1486399003099553836]) + IIF([Calculation_1486399003099553836] = 1, &apos; day&apos;, &apos; days&apos;), &apos;&apos;)' />
      </column>
      <column caption='Days with no traffic this week' datatype='integer' name='[Calculation_928000000000000036]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF IFNULL([Calculation_928000000000000007],0) &gt;= [Parameters].[Parameter 4] AND [Casino&apos;s Zero Traffic Days in past 7 days (copy)_1486399003116851248] &gt;= 1 THEN [Casino&apos;s Zero Traffic Days in past 7 days (copy)_1486399003116851248] END' />
      </column>
      <column caption='Casino Provider Go Live Date' datatype='date' name='[Casino Go Live Date (copy)_4064428315139358727]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{FIXED [Environment code],[Casino ID],[Game Provider]: &#10;MIN(IFNULL([Go Live Date],DATE(&apos;2099-12-31&apos;)))}' />
      </column>
      <column caption='Casino Go Live Date' datatype='date' name='[Casino Provider Go Live Date (copy)_1486399003113521199]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{FIXED [Environment code],[Casino ID] : &#10;MIN(IFNULL([Go Live Date],DATE(&apos;2099-12-31&apos;)))}' />
      </column>
      <column caption='Casino Provider Filter' datatype='integer' name='[Casino Provider Zero Traffic Days in past 7 days (copy)_1486399003140804659]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{FIXED [Environment code],[Casino ID]: max(&#10;7 - &#10;{FIXED [Environment code],[Casino ID],[Game Provider]:&#10;countd(if [DateOnly] &gt;= [Calculation_1486399003100078125] then [Calculation_1486399003093205027] else null end)}&#10;)}' />
      </column>
      <column caption='Casino Provider ZERO traffic days' datatype='integer' name='[Casino&apos;s Zero Traffic Days in past 7 days (copy)_1486399003116851248]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='7 - &#10;{FIXED [Environment code],[Casino ID],[Game Provider]:&#10;countd(if [DateOnly] &gt;= [Calculation_1486399003100078125] then [Calculation_1486399003093205027] else null end)}' />
      </column>
      <column caption='Casino no traffic filter' datatype='boolean' name='[Cleanup (copy)_1260163516106547201]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='ISNULL([Calculation_1486399003093372965])' />
