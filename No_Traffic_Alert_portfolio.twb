      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#f1ce63' fontname='Tableau Medium' fontsize='11'>No traffic this week (provider)</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>Casinos had traffic every day this week, but one or more providers did not. </run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>The number is how many days of this week that provider had no traffic. </run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'><![CDATA[Gray indicates that there were no traffic since <[federated.1mqe74i0nqo64h14i5wmi1a94h8d].[none:Calculation_1486399003103174702:ok]>]]></run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='traffic_monitor_synthetic' name='federated.1mqe74i0nqo64h14i5wmi1a94h8d' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Cleanup threshold' datatype='integer' name='[Parameter 1]' param-domain-type='range' role='measure' type='quantitative' value='500'>
              <calculation class='tableau' formula='500' />
              <range granularity='100' max='5000' min='0' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1mqe74i0nqo64h14i5wmi1a94h8d'>
            <column caption='less than threshold filter' datatype='boolean' name='[Calculation_1260163516106428416]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Calculation_911000000000000001] &lt; [Parameters].[Parameter 1]' />
            </column>
            <column caption='50 days filter' datatype='boolean' name='[Calculation_1486399001697423366]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[DateOnly] &gt; DATEADD(&apos;day&apos;,-50,[Calculation_1486399003099103274])' />
            </column>
            <column caption='Is Live?' datatype='string' name='[Calculation_1486399003040694304]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ISNULL([Go Live Date]) = TRUE then &apos;Not Live&apos; else &apos;Live&apos; end' />
            </column>
            <column caption='Date _ Have Traffic' datatype='date' name='[Calculation_1486399003093205027]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='if [Traffic Flag] = &apos;Have Traffic&apos; then [DateOnly] else NULL end' />
            </column>
            <column caption='Casino Last Traffic Day' datatype='date' name='[Calculation_1486399003093372965]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{FIXED [Environment code],[Casino ID]:MAX([Calculation_1486399003093205027])}' />
            </column>
            <column caption='Report Day' datatype='date' name='[Calculation_1486399003099103274]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{max([DateOnly])}' />
            </column>
            <column caption='Zero Traffic Days' datatype='integer' name='[Calculation_1486399003099553836]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='7 - &#10;{FIXED [Environment code],[Casino ID]:&#10;countd(if [DateOnly] &gt;= [Calculation_1486399003100078125] then [Calculation_1486399003093205027] else null end)}' />
            </column>
            <column caption='Date Start _ 7' datatype='date' name='[Calculation_1486399003100078125]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(DATEADD(&apos;day&apos;,-6,[Calculation_1486399003099103274]))' />
            </column>
            <column caption='Date Start _ 50' datatype='date' name='[Calculation_1486399003103174702]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATE(DATEADD(&apos;day&apos;,-49,[Calculation_1486399003099103274]))' />
            </column>
            <column caption='Assigned to KAM (demo: all)' datatype='boolean' name='[Calculation_402438912658776081]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='TRUE' />
            </column>
            <column caption='min(1)' datatype='integer' name='[Calculation_4064428315147575305]' role='measure' type='quantitative' user:unnamed='Casino Provider: 7 days'>
              <calculation class='tableau' formula='min(1)' />
            </column>
            <column caption='Team scope (demo: all)' datatype='boolean' name='[Calculation_547116999441444865]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='TRUE' />
            </column>
            <column caption='Total wager (50d)' datatype='real' name='[Calculation_911000000000000001]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [Environment code],[Casino ID] : SUM(IF [DateOnly] &gt;= [Calculation_1486399003103174702] THEN [Wager Eur] END)}' />
            </column>
            <column caption='Provider have-traffic days' datatype='integer' name='[Calculation_911000000000000004]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [Environment code],[Casino ID],[Game Provider] : COUNTD(IF [DateOnly] &gt;= [Calculation_1486399003103174702] THEN [Calculation_1486399003093205027] END)}' />
            </column>
            <column caption='Potential Wager' datatype='real' name='[Calculation_911000000000000006]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [Environment code],[Casino ID] : SUM(IF [Calculation_911000000000000004] &gt; 0 AND [DateOnly] &gt;= [Calculation_1486399003103174702] THEN [Wager Eur] / [Calculation_911000000000000004] * [Casino&apos;s Zero Traffic Days in past 7 days (copy)_1486399003116851248] END)}' />
            </column>
            <column caption='Cell status' datatype='string' name='[Calculation_911000000000000036]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_911000000000000004] = 0 THEN &apos;Never used (50d)&apos; ELSE STR([Casino&apos;s Zero Traffic Days in past 7 days (copy)_1486399003116851248]) END' />
            </column>
            <column caption='Casino Provider Go Live Date' datatype='date' name='[Casino Go Live Date (copy)_4064428315139358727]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{FIXED [Environment code],[Casino ID],[Game Provider]: &#10;MIN(IFNULL([Go Live Date],DATE(&apos;2099-12-31&apos;)))}' />
            </column>
            <column datatype='string' name='[Casino ID]' role='dimension' type='nominal' />
            <column caption='Casino Provider Filter' datatype='integer' name='[Casino Provider Zero Traffic Days in past 7 days (copy)_1486399003140804659]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{FIXED [Environment code],[Casino ID]: max(&#10;7 - &#10;{FIXED [Environment code],[Casino ID],[Game Provider]:&#10;countd(if [DateOnly] &gt;= [Calculation_1486399003100078125] then [Calculation_1486399003093205027] else null end)}&#10;)}' />
            </column>
            <column datatype='string' name='[Casino group]' role='dimension' type='nominal' />
            <column caption='Casino Provider ZERO traffic days' datatype='integer' name='[Casino&apos;s Zero Traffic Days in past 7 days (copy)_1486399003116851248]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='7 - &#10;{FIXED [Environment code],[Casino ID],[Game Provider]:&#10;countd(if [DateOnly] &gt;= [Calculation_1486399003100078125] then [Calculation_1486399003093205027] else null end)}' />
            </column>
            <column datatype='string' name='[Casino]' role='dimension' type='nominal' />
            <column caption='Casino no traffic filter' datatype='boolean' name='[Cleanup (copy)_1260163516106547201]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='ISNULL([Calculation_1486399003093372965])' />
            </column>
