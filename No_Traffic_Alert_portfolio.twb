      <column caption='Date Start _ 8' datatype='date' name='[Date Start _ 7 (copy)_6558437374309011456]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(DATEADD(&apos;day&apos;,-7,[Calculation_1486399003099103274]))' />
      </column>
      <column caption='Date _ No Traffic' datatype='date' name='[Date _ Have Traffic (copy)_4064428315080163333]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='if [Traffic Flag] = &apos;No Traffic&apos; then [DateOnly] else NULL end' />
